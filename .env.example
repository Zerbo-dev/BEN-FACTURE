# --- Application ---
APP_NAME="BAG Facture"
NEXT_PUBLIC_APP_NAME="BAG Facture"
APP_URL=https://ton-app.vercel.app
# 32 octets en base64 : openssl rand -base64 32
ENCRYPTION_KEY=
# Protège /api/cron/archive : openssl rand -hex 24 (Vercel l'envoie en Authorization: Bearer ...)
CRON_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Facultatif : lien affiché aux clients au forfait gratuit pour demander le passage au payant
# (ex. https://wa.me/22670000000). Sans cette variable, un texte de contact générique s'affiche.
NEXT_PUBLIC_UPGRADE_CONTACT_URL=

# --- Panneau admin (équipe B.A.G uniquement, /admin) ---
# E-mails autorisés, séparés par des virgules (doivent correspondre à un compte Supabase existant).
ADMIN_EMAILS=
# Facultatif : alerte Telegram si le cron d'archivage échoue (bot distinct des bots clients).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Archivage des sauvegardes de la base vers Google Drive (compte central) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
# Documents plus vieux que N mois => archivés puis allégés en base
ARCHIVE_AFTER_MONTHS=12
# Taille max de la base (octets) ; au-delà de 70 %, l'archivage passe à 3 mois
DB_LIMIT_BYTES=524288000
